# ──────────────────────────────────────────────
# WhatsApp Masivo — Variables de Entorno
# ──────────────────────────────────────────────
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
#
# Los scripts cargan dotenv automáticamente.
# ──────────────────────────────────────────────

# ─── Mensaje a enviar ───
WHATSAPP_MESSAGE="Buenas tardes. queria consultar precio y stock ?"

# ─── Archivos de datos ───
CSV_PATH=./contactos_moviles.csv
LOG_PATH=./envio_moviles.log

# ─── Sesión de WhatsApp ───
SESSION_PATH=./session_moviles

# ─── Navegador (Puppeteer) ───
CHROME_PATH=/opt/google/chrome/google-chrome
HEADLESS=false

# ─── Temporización ───
DELAY_MS=4000
INITIAL_DELAY_MS=5000

# ─── Reintentos ───
MAX_RETRIES=2
RETRY_DELAY_MS=4000

# ─── Timeout global (minutos, 0 = sin timeout) ───
TIMEOUT_MINUTES=0
