# ──────────────────────────────────────────────
# WhatsApp Masivo — Variables de Entorno
# ──────────────────────────────────────────────
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
#
# IMPORTANTE: Los scripts necesitan el paquete dotenv para leer este archivo:
#   npm install dotenv
#   require('dotenv').config();  // al inicio de cada script
# Luego reemplazar los valores hardcodeados con process.env.WHATSAPP_MESSAGE, etc.
# ──────────────────────────────────────────────

# ─── Mensaje a enviar ───
# Texto que se enviará a cada contacto.
WHATSAPP_MESSAGE="Buenas tardes. queria consultar precio y stock ?"

# ─── Archivos de datos ───
# Ruta al CSV con los contactos (formato: telefono|nombre).
CSV_PATH=./contactos.csv

# Ruta al archivo de log de envíos.
LOG_PATH=./envio.log

# ─── Sesión de WhatsApp ───
# Directorio donde se guarda la sesión autenticada.
# Si cambias este path, perderás la sesión y deberás escanear QR otra vez.
# El script que funcionó (enviar_todos.js) usa ./session_moviles.
SESSION_PATH=./session_moviles

# ─── Navegador (Puppeteer) ───
# Ruta al ejecutable de Chrome/Chromium.
# Si está vacío, Puppeteer usará su Chromium incluido.
# En servidores suele estar en /usr/bin/chromium-browser o similar.
CHROME_PATH=/opt/google/chrome/google-chrome

# Modo headless: true = sin ventana (ideal para servidor), false = muestra navegador.
HEADLESS=false

# ─── Temporización ───
# Espera (en milisegundos) entre envío de mensajes.
# Recomendado: 3000-5000 ms para evitar bloqueos de WhatsApp.
DELAY_MS=4000

# Espera inicial (en ms) después de conectar antes de empezar a enviar.
INITIAL_DELAY_MS=5000
